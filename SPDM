local function tabSwitch(s)
	s.Parent.MouseButton1Click:Connect(function()
		s.Parent.Frame.Visible = true
		for _, v in pairs(s.Parent.Parent.Parent.Tabs:GetChildren()) do
			v.Visible = (v.Name == s.Parent.Name)
		end
		for _, v in pairs(s.Parent.Parent:GetChildren()) do
			if v.Name ~= "UICorner" and v.Name ~= s.Parent.Name then
				v.Frame.Visible = false
			end
		end
	end)
end
