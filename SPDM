-- ============ SLIDER BUILDER ============
-- Uses visual bounds (handles -90 rotation) and screen-coord input so the
-- inner SliderButton can't steal the mouse.
local function BuildSlider(script, Toggle, MULT, IsGrav)
	local UIS = game:GetService("UserInputService")
	local Outer = script.Parent.Parent
	local Inner = script.Parent
	local TextLabel = Outer.TextLabel
	local sliding = false

	local function GetVisualBounds()
		local ap = Outer.AbsolutePosition
		local as = Outer.AbsoluteSize
		-- -90 rotation: visual is (as.Y wide) x (as.X tall), centered on the
		-- unrotated box's center.
		local cx = ap.X + as.X / 2
		local cy = ap.Y + as.Y / 2
		local vw, vh = as.Y, as.X
		return Vector2.new(cx - vw/2, cy - vh/2), Vector2.new(vw, vh)
	end

	local function Apply(p)
		TextLabel.Text = p .. "%"
		if Toggle.Value ~= true then return end
		local v = p * MULT
		if IsGrav then
			workspace.Gravity = v
		else
			local c = game.Players.LocalPlayer.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if not h then return end
			if Toggle.Name == "Jp" then
				h.JumpPower = v
				h.UseJumpPower = true
			elseif Toggle.Name == "Ws" then
				h.WalkSpeed = v
			end
		end
	end

	local function YtoP(y)
		local tl, sz = GetVisualBounds()
		if sz.Y <= 0 then return 0 end
		local rel = math.clamp((y - tl.Y) / sz.Y, 0, 1)
		-- top of visual = 100%, bottom = 0%
		return math.floor((1 - rel) * 100 + 0.5)
	end

	local function InSlider(x, y)
		local tl, sz = GetVisualBounds()
		return x >= tl.X and x <= tl.X + sz.X
			and y >= tl.Y and y <= tl.Y + sz.Y
	end

	local function SetFromInput(input)
		if Toggle.Value ~= true then return end
		local p = YtoP(input.Position.Y)
		Inner.Size = UDim2.fromScale(p / 100, 1)
		Apply(p)
	end

	-- Start drag via screen-coord click detection (bypasses Inner capture)
	UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local pos = input.Position
		if InSlider(pos.X, pos.Y) then
			if Toggle.Value == true then
				sliding = true
				SetFromInput(input)
			end
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not sliding then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			SetFromInput(input)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	-- When toggled on, apply current value to player
	Toggle:GetPropertyChangedSignal("Value"):Connect(function()
		if Toggle.Value == true then
			Apply(tonumber(TextLabel.Text:match("%d+")) or 0)
		end
	end)
end

local AZY_REQUIRE = require;
local AZY_MODULES = {};
local function require(Module)
	local M = AZY_MODULES[Module];
	if M then
		if not M.Required then
			M.Required = true;
			M.Value = M.Closure();
		end
		return M.Value;
	end;
	return AZY_REQUIRE(Module);
end

AZY_MODULES[AZY["12b"]] = { Closure = function()
	local script = AZY["12b"];
	local module = {}
	local syntax = require(script.Syntax)
	local getLines = require(script.GetLines)
	local fakeEditor = require(script.FakeEditor)
	local textFixer = require(script.TextFixer)
	local getLine = require(script.GetLine)
	local tween = require(script.TweenLibrary)
	local suggestions = require(script.Suggestions)
	function module.new(frame)
		local newEditor = script.Editor:Clone()
		newEditor.Parent = frame
		local editorObj = fakeEditor.new(newEditor)
		local textbox = newEditor.Scroll.Source
		local linesLabel = newEditor.Scroll.Left.Lines
		local lineHighlight = textbox.LineHighlight
		local highlightBox = Instance.new("TextLabel")
		highlightBox.Size = UDim2.new(1, 0, 1, 0)
		highlightBox.TextColor3 = textbox.TextColor3
		highlightBox.BackgroundTransparency = 1
		highlightBox.Name = "Syntax"
		highlightBox.RichText = true
		highlightBox.TextSize = textbox.TextSize
		highlightBox.Font = textbox.Font
		highlightBox.TextXAlignment = Enum.TextXAlignment.Left
		highlightBox.TextYAlignment = Enum.TextYAlignment.Top
		highlightBox.TextStrokeColor3 = Color3.fromRGB(40, 40, 40)
		highlightBox.TextStrokeTransparency = 0.1
		highlightBox.Text = ""
		highlightBox.Parent = textbox
		editorObj:SetTheme("default")
		textFixer.Fix(highlightBox)
		suggestions:Start(newEditor)
		textbox:GetPropertyChangedSignal("Text"):Connect(function()
			syntax.Highlight(highlightBox, textbox.Text)
			textbox.Text = textbox.Text:gsub("\t", "    ")
			linesLabel.Text = getLines.GetLinesString(textbox.Text)
		end)
		textbox:GetPropertyChangedSignal("CursorPosition"):Connect(function()
			local y = ((getLine:GetCurrentLine(textbox) * textbox.TextSize) - math.ceil(lineHighlight.AbsoluteSize.Y / 2)) + 4
			if y ~= lineHighlight.Position.Y.Offset then
				tween.TweenPosition(lineHighlight, UDim2.new(0, -10, 0, y), 0.1, Enum.EasingStyle.Quad)
			end
		end)
		return editorObj
	end
	return module
end };
