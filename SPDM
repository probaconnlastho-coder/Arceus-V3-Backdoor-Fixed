-- ============ SCANNER (auto, dot only) ============
task.spawn(function()
	local dot = AZY["14c3"]
	local SUSPICIOUS = {
		"backdoor","admin","execute","inject","cmd","command","loadstring",
		"kick","ban","kill","give","hack","exploit","fire","trigger",
		"anticheat","bypass","token","auth","debug","logger","stealer",
		"grabber","rat","websocket","request","httpspy","eval","payload",
		"ss","script","getadmin","giveadmin","newadmin","crash","freeze",
	}
	local LOCS = {
		game:GetService("ReplicatedStorage"), game:GetService("ReplicatedFirst"),
		game:GetService("ServerStorage"), game:GetService("ServerScriptService"),
		game:GetService("Workspace"), game:GetService("Players"),
		game:GetService("StarterGui"), game:GetService("StarterPack"),
		game:GetService("Lighting"), game:GetService("SoundService"),
		game:GetService("Chat"), game:GetService("Teams"),
	}
	local function scan()
		dot.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
		task.wait()
		local flagged = 0
		local total = 0
		for _, loc in ipairs(LOCS) do
			pcall(function()
				for _, obj in ipairs(loc:GetDescendants()) do
					if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
						total = total + 1
						local l = obj.Name:lower()
						for _, k in ipairs(SUSPICIOUS) do
							if l:find(k, 1, true) then
								flagged = flagged + 1
								warn("[Scanner] Suspicious: [" .. obj.ClassName .. "] " .. obj:GetFullName() .. " (matched: " .. k .. ")")
								break
							end
						end
					end
				end
			end)
		end
		if flagged > 0 then
			dot.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			warn(string.format("[Scanner] 🟢 BACKDOOR - %d/%d flagged", flagged, total))
		else
			dot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			print(string.format("[Scanner] 🔴 Clean - %d remotes scanned", total))
		end
	end
	task.wait(2)
	scan()
	while task.wait(10) do scan() end
end)

